From dabf243285ff4ffe588a78cddc499151e5307718 Mon Sep 17 00:00:00 2001
From: jj <jj@imput.net>
Date: Fri, 02 Oct 2026 02:02:52 -0700
Subject: [PATCH] [MediaFoundation] Preserve source geometry in video media types

A video's display size can differ from its size in source pixels.
In Chromium, there is visible_rect() for the image region, and
natural_size() with the aspect correction for display [1].
For example, a 1920x1080 image can have a natural size of 2420x1080.

GetVideoType() currently uses natural_size() for the geometric aperture
while also calculating a pixel aspect ratio from the visible and
natural sizes. For a 1920x1080 frame with a natural size of 2420x1080,
this describes a 2420-pixel-wide aperture inside a 1920-pixel-wide
frame. Under Media Foundation's documented formula, aperture aspect
ratio multiplied by pixel aspect ratio, those attributes also account
for the aspect correction twice [2].

Make it so the aperture describes the visible image before it is
stretched for display. The pixel aspect ratio then accounts for that
stretch exactly once [2].

Use coded_size(), which includes the full frame rather than just its
visible region [1], for MF_MT_FRAME_SIZE [3]. Keep the pixel aspect
ratio calculation based on the visible image, so padding does not
affect the picture's proportions.

[1] //media/base/video_decoder_config.h
[2] https://learn.microsoft.com/en-us/windows/win32/medfound/mf-mt-geometric-aperture-attribute
[3] https://learn.microsoft.com/en-us/windows/win32/medfound/mf-mt-frame-size-attribute

Bug: None
Change-Id: I6f5408e3ebf0a323f575e5394a582f7168a62852
Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8470408
Commit-Queue: jj <jj@chromium.org>
Reviewed-by: Sangbaek Park <sangbaekpark@chromium.org>
Cr-Commit-Position: refs/heads/main@{#1709866}
---

--- a/media/renderers/win/media_foundation_video_stream.cc
+++ b/media/renderers/win/media_foundation_video_stream.cc
@@ -208,21 +208,27 @@ HRESULT GetVideoType(const VideoDecoderC
   }
   RETURN_IF_FAILED(media_type->SetGUID(MF_MT_SUBTYPE, mf_subtype));
 
-  UINT32 width = config.visible_rect().width();
-  UINT32 height = config.visible_rect().height();
-  RETURN_IF_FAILED(
-      MFSetAttributeSize(media_type.Get(), MF_MT_FRAME_SIZE, width, height));
+  // Frame size is the encoded pixel raster; cropping is described separately
+  // by the geometric aperture below.
+  UINT32 coded_width = config.coded_size().width();
+  UINT32 coded_height = config.coded_size().height();
+  RETURN_IF_FAILED(MFSetAttributeSize(media_type.Get(), MF_MT_FRAME_SIZE,
+                                      coded_width, coded_height));
 
   UINT32 natural_width = config.natural_size().width();
   UINT32 natural_height = config.natural_size().height();
   RETURN_IF_FAILED(
       MFSetAttributeRatio(media_type.Get(), MF_MT_PIXEL_ASPECT_RATIO,
-                          height * natural_width, width * natural_height));
+                          config.visible_rect().height() * natural_width,
+                          config.visible_rect().width() * natural_height));
 
   MFVideoArea area;
   area.OffsetX = MakeOffset(static_cast<float>(config.visible_rect().x()));
   area.OffsetY = MakeOffset(static_cast<float>(config.visible_rect().y()));
-  area.Area = config.natural_size().ToSIZE();
+  // Aperture is in source pixels, not aspect-corrected display pixels. Using
+  // natural_size here applies the pixel aspect ratio twice and can describe
+  // an aperture larger than the frame for anamorphic video.
+  area.Area = config.visible_rect().size().ToSIZE();
   RETURN_IF_FAILED(media_type->SetBlob(MF_MT_GEOMETRIC_APERTURE, (UINT8*)&area,
                                        sizeof(area)));
 
