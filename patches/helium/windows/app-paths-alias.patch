+void DeleteChromeAppPathsKeyIfOwned(HKEY root,
+                                    const base::FilePath& chrome_exe) {
+  const std::wstring app_path_key =
+      base::StrCat({ShellUtil::kAppPathsRegistryKey, L"\\", kChromeExe});
+  base::win::RegKey key(root, app_path_key.c_str(), KEY_QUERY_VALUE);
+  std::wstring app_path;
+  if (key.ReadValue(nullptr, &app_path) != ERROR_SUCCESS) {
+    return;
+  }
+  key.Close();
+
+  // The value is a bare path, not a command line, so compare it as a path.
+  if (ProgramCompare(chrome_exe).EvaluatePath(base::FilePath(app_path))) {
+    DeleteRegistryKey(root, app_path_key, WorkItem::kWow64Default);
+  }
+}
