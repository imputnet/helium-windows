+#!/usr/bin/env python3
+# Copyright 2026 The Helium Authors
+# Use of this source code is governed by the terms of the GPL-3.0 license in LICENSE.
+"""Stage locally installed Windows headers for remote compilation."""
+
+import hashlib
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+
+def stage_includes(includes, source_tree):
+    """Mirror SDK includes into the input tree, copying only changed files."""
+    root = Path(source_tree).resolve() / 'third_party/helium_win_headers'
+    result = []
+    for include in includes:
+        source = Path(include).resolve()
+        if not source.is_dir():
+            raise RuntimeError(f'Windows include directory does not exist: {source}')
+        key = hashlib.sha256(str(source).casefold().encode()).hexdigest()[:16]
+        destination = root / key / source.name
+        destination.relative_to(root)
+        copy = subprocess.run([
+            'robocopy', str(source), str(destination), '/MIR', '/R:0', '/W:0',
+            '/NFL', '/NDL', '/NJH', '/NJS', '/NP',
+        ], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
+        # Robocopy's codes 0-7 are successful copy/synchronization outcomes.
+        if copy.returncode >= 8:
+            raise RuntimeError(f'Failed to stage {source}: {copy.stdout}')
+        result.append(os.path.relpath(destination).replace('\\', '/'))
+    return result
+
+
+if __name__ == '__main__':
+    includes = stage_includes(sys.argv[1:], Path(__file__).resolve().parents[2])
+    print(Path(includes[0]).resolve().as_posix())
