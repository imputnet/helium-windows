+#!/usr/bin/python3
+# Copyright 2026 The Helium Authors
+# Use of this source code is governed by the terms of the GPL-3.0 license in LICENSE.
+"""Run Windows clang-cl commands with the matching Linux Clang on NativeLink."""
+
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+
+def header_overlay(headers):
+    """Preserve Windows SDK's case-insensitive include lookup on Linux."""
+    roots = []
+    for directory, _, files in os.walk(headers):
+        roots.append({
+            'type': 'directory', 'name': str(Path(directory).resolve()),
+            'contents': [
+                {'type': 'file', 'name': name,
+                 'external-contents': str((Path(directory) / name).resolve())}
+                for name in files
+            ],
+        })
+    return {'version': 0, 'case-sensitive': False, 'use-external-names': False,
+            'roots': roots}
+
+
+def compiler_command(args, source_tree, overlay):
+    # Siso includes the original compiler in args[0].
+    clang_root = source_tree / 'third_party/llvm-build'
+    resources = list((clang_root / 'Release+Asserts/lib/clang').iterdir())
+    if len(resources) != 1:
+        raise RuntimeError('Expected one Windows Clang resource directory')
+    return [
+        str(clang_root / 'Release+Asserts_linux/bin/clang'),
+        '--driver-mode=cl', '--target=x86_64-pc-windows-msvc',
+        '--rsp-quoting=windows', '-resource-dir=' + str(resources[0]),
+        '-Xclang', '-ivfsoverlay', '-Xclang', str(overlay),
+        *args[1:],
+    ]
+
+
+def rewrite_include(line, source_tree):
+    """Map Clang's /showIncludes output back to paths Siso can find locally."""
+    prefix = 'Note: including file:'
+    if line.startswith(prefix):
+        name = Path(line[len(prefix):].strip())
+        if name.is_absolute() and name.is_relative_to(source_tree):
+            return prefix + ' ' + os.path.relpath(name).replace('\\', '/') + '\n'
+    return line
+
+
+def main():
+    source_tree = Path(__file__).resolve().parents[2]
+    with tempfile.TemporaryDirectory() as temporary:
+        overlay = Path(temporary) / 'windows-headers.json'
+        overlay.write_text(json.dumps(header_overlay(
+            source_tree / 'third_party/helium_win_headers')))
+        with subprocess.Popen(
+                compiler_command(sys.argv[1:], source_tree, overlay),
+                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+                encoding='utf-8', errors='replace') as compiler:
+            for line in compiler.stdout:
+                sys.stdout.write(rewrite_include(line, source_tree))
+            return compiler.wait()
+
+
+if __name__ == '__main__':
+    sys.exit(main())
