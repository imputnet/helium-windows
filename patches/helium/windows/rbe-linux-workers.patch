+# Copyright 2026 The Helium Authors
+# Use of this source code is governed by the terms of the GPL-3.0 license in LICENSE.
+"""Compile on Linux workers using the locally staged Windows SDK headers."""
+
+load("@builtin//struct.star", "module")
+load("./clang_all.star", "clang_all")
+load("./clang_exception.star", "clang_exception")
+
+def __filegroups(ctx):
+    groups = clang_all.filegroups(ctx)
+    # Siso misses SDK dependencies behind -imsvc and precomputed libc++ groups,
+    # so each compile needs the complete SDK.
+    groups["third_party/helium_win_headers:headers"] = {
+        "type": "glob",
+        "includes": ["*"],
+    }
+    return groups
+
+def __step_config(ctx, step_config):
+    step_config["input_deps"].update(clang_all.input_deps(ctx))
+    step_config["executables"].extend([
+        "buildtools/helium_rbe/clang_remote_wrapper.py",
+        "third_party/llvm-build/Release+Asserts_linux/bin/clang",
+    ])
+    for action in ["cc", "cxx"]:
+        step_config["rules"].append({
+            "name": "clang-cl/" + action,
+            "action": "(.*_)?" + action,
+            "command_prefix": "..\\..\\third_party\\llvm-build\\Release+Asserts\\bin\\clang-cl.exe",
+            "handler": "clang_compile",
+            "inputs": [
+                "buildtools/helium_rbe/clang_remote_wrapper.py",
+                "third_party/llvm-build/Release+Asserts_linux/bin/clang",
+                "third_party/llvm-build/Release+Asserts:headers",
+                "third_party/helium_win_headers:headers",
+            ],
+            "remote": True,
+            "remote_wrapper": "../../buildtools/helium_rbe/clang_remote_wrapper.py",
+            "timeout": "7m",
+        })
+    return clang_exception.step_config(ctx, step_config, False)
+
+clang = module(
+    "clang",
+    filegroups = __filegroups,
+    step_config = __step_config,
+)
